#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-commit security checks..."

# Check for .env files
if git diff --cached --name-only | grep -E "^\.env$|^\.env\.local$"; then
  echo "❌ ERROR: Attempting to commit .env file!"
  echo "   .env files contain sensitive credentials and should NEVER be committed."
  echo "   Please remove them from staging: git restore --staged .env"
  exit 1
fi

# Check for session files
if git diff --cached --name-only | grep -E "\.session\.json$|sessions/"; then
  echo "❌ ERROR: Attempting to commit session files!"
  echo "   Session files contain authentication cookies."
  echo "   Please remove them from staging."
  exit 1
fi

# Check for common secret patterns in staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|json|env)$' || true)

if [ -n "$STAGED_FILES" ]; then
  # Check for potential API keys
  if echo "$STAGED_FILES" | xargs grep -E "AKIA[0-9A-Z]{16}" 2>/dev/null; then
    echo "⚠️  WARNING: Possible AWS API key detected!"
    echo "   Please verify this is not a real credential."
    exit 1
  fi

  # Check for Twitter tokens
  if echo "$STAGED_FILES" | xargs grep -E "[0-9]{15,20}-[A-Za-z0-9]{20,50}" 2>/dev/null | grep -i "twitter\|access_token" 2>/dev/null; then
    echo "⚠️  WARNING: Possible Twitter access token detected!"
    echo "   Please verify this is not a real credential."
    exit 1
  fi

  # Check for private keys
  if echo "$STAGED_FILES" | xargs grep -E "-----BEGIN (RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY" 2>/dev/null; then
    echo "❌ ERROR: Private key detected!"
    echo "   Private keys should NEVER be committed."
    exit 1
  fi

  # Check for passwords (excluding placeholders)
  if echo "$STAGED_FILES" | xargs grep -E 'PASSWORD.*=.*["\047](?!your_|placeholder|example|test)' 2>/dev/null | grep -v "\.env\.example" 2>/dev/null; then
    echo "⚠️  WARNING: Possible password detected!"
    echo "   Please verify this is not a real password."
    read -p "   Continue anyway? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      exit 1
    fi
  fi
fi

echo "✅ Pre-commit security checks passed!"
exit 0

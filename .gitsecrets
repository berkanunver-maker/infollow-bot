# Git Secrets Configuration
# This file defines patterns to prevent committing sensitive data

# Prevent committing actual .env files
.env
.env.local
.env.*.local

# Instagram credentials patterns
INSTAGRAM_PASSWORD=(?!your_|placeholder|example|test)[A-Za-z0-9@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]+

# Twitter API keys patterns
# Twitter API keys are typically 25 characters
TWITTER_API_KEY=[A-Za-z0-9]{20,30}
TWITTER_API_SECRET=[A-Za-z0-9]{40,50}
TWITTER_ACCESS_TOKEN=[0-9]{15,20}-[A-Za-z0-9]{20,50}
TWITTER_ACCESS_SECRET=[A-Za-z0-9]{40,50}

# Generic API key patterns
[aA][pP][iI]_?[kK][eE][yY].*['|\"][0-9a-zA-Z]{32,45}['|\"]
[aA][pP][iI]_?[sS][eE][cC][rR][eE][tT].*['|\"][0-9a-zA-Z]{32,45}['|\"]
[aA][cC][cC][eE][sS][sS]_?[tT][oO][kK][eE][nN].*['|\"][0-9a-zA-Z]{32,45}['|\"]

# AWS keys
AKIA[0-9A-Z]{16}
[aA][wW][sS].*['|\"][0-9a-zA-Z\/+]{40}['|\"]

# Google API keys
AIza[0-9A-Za-z\-_]{35}

# Private keys
-----BEGIN (?:RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY

# Session files
*.session.json
instagram_session.json

# Common password patterns (not in placeholder format)
[pP][aA][sS][sS][wW][oO][rR][dD].*['|\"](?!your_|placeholder|example|test)[A-Za-z0-9@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]{6,}['|\"]

# Generic secret patterns
[sS][eE][cC][rR][eE][tT].*['|\"][A-Za-z0-9]{16,}['|\"]
[tT][oO][kK][eE][nN].*['|\"][A-Za-z0-9]{16,}['|\"]

{
  "name": "infollow-bot",
  "version": "1.0.0",
  "description": "Automated Instagram follow tracker bot with Twitter integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "worker": "ts-node src/worker.ts",
    "scrape": "ts-node src/scrape.ts",
    "test": "jest",
    "prepare": "husky install",
    "validate": "ts-node src/utils/validate-config.ts",
    "help": "ts-node src/cli/help.ts",
    "status": "ts-node src/cli/status.ts",
    "stats": "ts-node src/cli/stats.ts",
    "setup": "ts-node src/cli/setup.ts"
  },
  "keywords": [
    "instagram",
    "twitter",
    "automation",
    "scraping",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "date-fns": "^2.30.0",
    "diff": "^5.1.0",
    "dotenv": "^16.3.1",
    "inquirer": "^8.2.5",
    "node-cron": "^3.0.3",
    "p-retry": "^5.1.2",
    "playwright": "^1.40.0",
    "twitter-api-v2": "^1.15.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/diff": "^5.0.8",
    "@types/inquirer": "^8.2.6",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

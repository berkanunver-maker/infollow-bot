{
  "name": "infollow-bot",
  "version": "1.0.0",
  "description": "Automated Instagram follow tracker bot with Twitter integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "worker": "ts-node src/worker.ts",
    "scrape": "ts-node src/scrape.ts",
    "test": "jest",
    "prepare": "husky install",
    "validate": "ts-node src/utils/validate-config.ts"
  },
  "keywords": [
    "instagram",
    "twitter",
    "automation",
    "scraping",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.40.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "playwright-stealth": "^1.0.6",
    "twitter-api-v2": "^1.15.0",
    "node-cron": "^3.0.3",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "diff": "^5.1.0",
    "date-fns": "^2.30.0",
    "p-retry": "^5.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/diff": "^5.0.8",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "husky": "^8.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

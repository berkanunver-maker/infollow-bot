# Instagram Credentials
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Twitter/X API Credentials (v2)
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# Bot Configuration
CRON_SCHEDULE=0 */6 * * *
# Cron schedule (default: every 6 hours)
# Format: minute hour day month weekday
# Examples:
# - "0 */6 * * *" = Every 6 hours
# - "0 0 * * *" = Daily at midnight
# - "0 */2 * * *" = Every 2 hours

# Instagram Target Account
TARGET_INSTAGRAM_USERNAME=account_to_track

# Data Storage
DATA_DIR=./data
SNAPSHOTS_DIR=./data/snapshots
SCREENSHOTS_DIR=./data/screenshots

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Browser Configuration
HEADLESS=true
BROWSER_TIMEOUT=60000

# Proxy Configuration (Optional - for IP rotation)
# Leave empty to not use proxy
USE_PROXY=false
PROXY_SERVER=
# Examples:
# - http://proxy.example.com:8080
# - socks5://proxy.example.com:1080
PROXY_USERNAME=
PROXY_PASSWORD=

# Security Configuration
USE_STEALTH_MODE=true
USE_SESSION_PERSISTENCE=true
# Session files stored in ./data/sessions/

# Rate Limiting
MIN_DELAY=1000
# Minimum delay between actions (milliseconds)
MAX_DELAY=3000
# Maximum delay between actions (milliseconds)

# ====================
# NOTIFICATION SETTINGS
# ====================

# Twitter Notifications (enabled by default)
ENABLE_TWITTER_NOTIFICATIONS=true

# Discord Notifications
ENABLE_DISCORD_NOTIFICATIONS=false
DISCORD_WEBHOOK_URL=
# Get webhook URL from Discord: Server Settings > Integrations > Webhooks
DISCORD_MENTION_ROLE=
# Optional: @everyone, @here, or role ID (e.g., <@&123456789>)
DISCORD_COLOR=3447003
# Embed color in decimal (default: blue #3498db)

# Email Notifications
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_PROVIDER=smtp
# Options: gmail, outlook, smtp
EMAIL_FROM=bot@example.com
EMAIL_TO=you@example.com
# SMTP Settings (for custom SMTP or Gmail/Outlook)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
# true for port 465, false for other ports
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASS=your_app_password
# For Gmail: Use App Password (not regular password)
# https://support.google.com/accounts/answer/185833

# Slack Notifications
ENABLE_SLACK_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=
# Get webhook URL from Slack: Your Workspace > Apps > Incoming Webhooks
SLACK_CHANNEL=#instagram-alerts
# Optional: Override default channel
SLACK_USERNAME=Instagram Bot
# Bot display name
SLACK_ICON_EMOJI=:camera:
# Bot icon emoji

# Telegram Notifications
ENABLE_TELEGRAM_NOTIFICATIONS=false
TELEGRAM_BOT_TOKEN=
# Get token from @BotFather: /newbot
TELEGRAM_CHAT_ID=
# Your chat ID or group ID (use @userinfobot to get your ID)

# ====================
# MULTI-ACCOUNT SETTINGS
# ====================

# Multi-Account Support
ENABLE_MULTI_ACCOUNT=false
TARGET_ACCOUNTS_FILE=./targets.json
# Path to JSON file with multiple accounts
# Example format: [{"username": "user1", "tweetEnabled": true}, ...]
PARALLEL_SCRAPING=false
# true: scrape accounts in parallel (faster but risky)
# false: scrape sequentially (slower but safer)
DELAY_BETWEEN_ACCOUNTS=60000
# Delay between accounts in milliseconds (default: 60s)

# ====================
# EXPORT SETTINGS
# ====================

# CSV Export
ENABLE_CSV_EXPORT=false
AUTO_EXPORT_CSV=false
# Auto export on each change

# Excel Export
ENABLE_EXCEL_EXPORT=false
AUTO_EXPORT_EXCEL=false
# Auto export on each change

EXPORT_DIR=./exports
# Directory for exported files

# ====================
# WEB DASHBOARD
# ====================

ENABLE_DASHBOARD=false
DASHBOARD_PORT=3000
DASHBOARD_USERNAME=admin
# Dashboard login username
DASHBOARD_PASSWORD=changeme
# Dashboard login password (CHANGE THIS!)
